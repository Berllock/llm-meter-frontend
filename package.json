{
  "name": "llm-meter-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run test && npm run build && npm run desktop:build",
    "desktop:build": "tsc -p tsconfig.desktop.json",
    "desktop:prepare-backend": "node scripts/prepare-backend.mjs",
    "desktop:prepare": "npm run desktop:prepare-backend && npm run build && npm run desktop:build",
    "desktop": "npm run desktop:prepare && electron .",
    "desktop:start": "electron .",
    "test:desktop": "node scripts/test-desktop.mjs",
    "desktop:prepare-runtime": "node scripts/prepare-runtime.mjs",
    "desktop:dist": "npm run desktop:prepare && npm run desktop:prepare-runtime && node scripts/prepare-distribution.mjs && electron-builder --config electron-builder.config.cjs --linux AppImage tar.gz --x64 --publish never && node scripts/verify-distribution.mjs",
    "test:packaged": "node scripts/test-desktop.mjs --packaged"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "jsdom": "30.1.3",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist-desktop/desktop/main.js",
  "description": "Local desktop dashboard for observed LLM usage.",
  "author": "LLM Meter Personal contributors"
}
