{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "rootDir": ".", "outDir": "dist-desktop", "strict": true,
    "skipLibCheck": true, "types": ["node"], "verbatimModuleSyntax": true,
    "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["desktop/**/*.ts", "desktop/**/*.cts", "shared/**/*.ts"],
  "exclude": ["desktop/**/*.test.ts"]
}
